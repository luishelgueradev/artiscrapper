# Copy to .env and fill in real values. `docker compose` picks .env up automatically.
# DO NOT commit your actual .env (it should be in .gitignore).

# ── Phase 2 — MVP ──
# Required: no default — pydantic raises ValidationError at startup if absent.
LLM_ROUTER_BEARER_TOKEN=

# Optional defaults — uncomment to override.
# LLM_ROUTER_URL=http://host.docker.internal:3210
# LLM_MODEL=llama3.2:3b-instruct-q4_K_M
# BROWSER-04 (Path B perf-audit 2026-06-04): 0 enables the 2 paralleled Google
# fetches inside a single /search request to run truly parallel. Was 60 — that
# value added a forced ~60s sleep to every cold path.
# GOOGLE_MIN_INTERVAL_S=0
# BROWSER_RECYCLE_AFTER=200
# LLM-03 (Path B perf-audit 2026-06-04): empirically optimal against
# local-llms-router. Was 4 — sem(4) and sem(2) give the same throughput.
# LLM_CONCURRENCY=8
# LOG_JSON=true
# LOG_LEVEL=INFO

# ── Phase 3 — Robustness ──
# D-01: comma-separated API keys. Empty ⇒ /search rejects every request with
# 401. Rotation requires a container restart (per D-01).
API_KEYS=

# D-02 / Phase 3.1 D-05: per-key quotas wired into the slowapi decorators on
# POST /search via module constants in main.py (_RATE_LIMIT_PER_MINUTE /
# _RATE_LIMIT_PER_DAY). Bumping these vars + `compose up --force-recreate`
# propagates to the runtime hot path AND the `rate_limit_init` log line.
# API_RATE_PER_MINUTE=60
# API_RATE_PER_DAY=10000

# D-14: empty ⇒ Sentry SDK is NOT initialized. Set in production deploy only.
# OBS-05: the DSN value is never logged.
SENTRY_DSN=

# ── Phase 0.2.2 — Harness Paridad Visual Continua ──
# Fraction (0.0..1.0) of /search requests sampled for parity audit. Each
# sampled request reuses the HTML the pipeline already produced (no extra
# Cloak fetch) and runs the parser metric helper in a fire-and-forget bg
# task. Overhead <50ms p99 on a 1.5 MB SERP HTML. Set to 0.0 to disable.
# PARITY_SAMPLE_RATE=0.1
